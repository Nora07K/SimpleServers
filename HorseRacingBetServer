#!/usr/bin/env bash

NumbOfHorse=6
DistanceToWin=20

echo "There are $NumbOfHorse horses racing, what horse do you want to bet on winning the race"

UsersBettedHorse=0
while [[ $UsersBettedHorse -lt 1 || $UsersBettedHorse -gt $NumbOfHorse ]]; do
	read -r UsersBettedHorse
	if [[ $UsersBettedHorse -lt 1 || $UsersBettedHorse -gt $NumbOfHorse ]]; then
		echo "$UsersBettedHorse is not a valid horse to place a bet on, please reinput the horses number"
	fi
done	

#echo "$UsersBettedHorse is your hourse number you betted on"


declare -a HorseArray

for ((i=1; i<=NumbOfHorse; i++)); do
	HorseArray[i]=0
done

WinningHorse=0
while ((WinningHorse == 0)); do
	HorseThatMoves=$(( RANDOM % NumbOfHorse + 1 ))
	#echo "$HorseThatMoves horse moved forward"

	((HorseArray[HorseThatMoves]++))
	
	if (( HorseArray[HorseThatMoves] >= DistanceToWin )); then
		WinningHorse=$HorseThatMoves
	fi
done	

echo "Winning Horse is number $WinningHorse"

if (( UsersBettedHorse == WinningHorse )); then
    echo "You won your bet!"
else
    echo "You lost your bet!"
fi


echo "Scoreboard of the race:"
for ((i=1; i<=NumbOfHorse; i++)); do
    echo "${HorseArray[i]} steps: Horse $i"
done | sort -rn
